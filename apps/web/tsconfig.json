{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "../..",
    "outDir": "dist",
    "noEmitOnError": true
  },
  "include": [
    "src/**/*.ts",
    "../../packages/contracts/src/**/*.ts"
  ]
}
