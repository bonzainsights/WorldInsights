# ============================================
# WorldInsights Backend - Environment Configuration
# Complete rebuild with all free/open API integrations
# ============================================

# ============================================
# Application Settings
# ============================================
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_APP=run.py
SECRET_KEY=your-secret-key-change-this-in-production

# Server configuration
HOST=0.0.0.0
PORT=5000

# ============================================
# Database Configuration
# ============================================
DUCKDB_PATH=./data/worldinsights.duckdb
DATABASE_URL=duckdb:///./data/worldinsights.duckdb

# ============================================
# Cache Configuration
# ============================================
# Use 'redis' for production, 'simple' for development
CACHE_TYPE=simple
CACHE_TTL=3600
CACHE_DEFAULT_TIMEOUT=300

# Redis configuration (for production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ============================================
# Rate Limiting Configuration
# ============================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_STORAGE_URL=memory://
RATE_LIMIT_DEFAULT=100 per minute
RATE_LIMIT_API=60 per minute

# ============================================
# API Client Configuration (Global)
# ============================================
API_TIMEOUT=30
API_RETRY_COUNT=3
API_RETRY_BACKOFF=0.5
API_USER_AGENT=WorldInsights/2.0

# ============================================
# Primary Data Source APIs (Mandatory)
# ============================================

# World Bank Open Data API
# https://datahelpdesk.worldbank.org/knowledgebase/api
# No API key required - free access
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2
WORLD_BANK_ENABLED=True
WORLD_BANK_RATE_LIMIT=10 per second
WORLD_BANK_CACHE_TTL=86400

# WHO Open Data API (Global Health Observatory)
# https://ghoapi.azureedge.net/api/
# No API key required - free access
WHO_BASE_URL=https://ghoapi.azureedge.net/api
WHO_ENABLED=True
WHO_RATE_LIMIT=5 per second
WHO_CACHE_TTL=86400

# FAO FAOSTAT API
# https://www.fao.org/faostat/en/#home
# No API key required for basic access
FAO_BASE_URL=https://www.fao.org/faostat/api
FAO_ENABLED=True
FAO_RATE_LIMIT=5 per second
FAO_CACHE_TTL=86400

# NASA/NOAA Climate Data
# https://data.nasa.gov/ & https://www.ncdc.noaa.gov/cdo-web/api/v2
# NASA API key (free) - get from https://api.nasa.gov/
NASA_BASE_URL=https://api.nasa.gov
NASA_CDO_BASE_URL=https://www.ncdc.noaa.gov/cdo-web/api/v2
NASA_API_KEY=DEMO_KEY
NASA_ENABLED=True
NASA_RATE_LIMIT=10 per hour
NASA_CACHE_TTL=604800

# ============================================
# Additional Free APIs
# ============================================

# UN Data API
# https://data.un.org/
UN_DATA_BASE_URL=https://data.un.org/ws/rest
UN_DATA_ENABLED=True
UN_DATA_RATE_LIMIT=5 per second
UN_DATA_CACHE_TTL=86400

# Our World in Data API
# https://ourworldindata.org/api
OWID_BASE_URL=https://ourworldindata.org/api
OWID_ENABLED=True
OWID_RATE_LIMIT=5 per second
OWID_CACHE_TTL=86400

# IMF Data API
# https://data.imf.org/
# Free registration may be required
IMF_BASE_URL=https://sdmxcentral.imf.org/ws/public/sdmxapi
IMF_ENABLED=True
IMF_RATE_LIMIT=5 per second
IMF_CACHE_TTL=86400

# UNESCO Institute for Statistics API
# http://uis.unesco.org/
UNESCO_BASE_URL=http://uis.unesco.org/api
UNESCO_ENABLED=True
UNESCO_RATE_LIMIT=5 per second
UNESCO_CACHE_TTL=86400

# ILO (International Labour Organization) API
# https://ilostat.ilo.org/
ILO_BASE_URL=https://www.ilo.org/ilostat/sdmx/ws/rest
ILO_ENABLED=True
ILO_RATE_LIMIT=5 per second
ILO_CACHE_TTL=86400

# ITU (International Telecommunication Union) API
# https://data.itu.int/
ITU_BASE_URL=https://data.itu.int/api
ITU_ENABLED=True
ITU_RATE_LIMIT=5 per second
ITU_CACHE_TTL=86400

# World Tourism Organization (UNWTO)
# https://www.unwto.org/
UNWTO_BASE_URL=https://www.unwto.org/api
UNWTO_ENABLED=True
UNWTO_RATE_LIMIT=5 per second
UNWTO_CACHE_TTL=86400

# Open-Meteo (Weather/Climate - free, no key required)
# https://open-meteo.com/
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_ENABLED=True
OPEN_METEO_RATE_LIMIT=10 per second
OPEN_METEO_CACHE_TTL=3600

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE=./logs/worldinsights.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ============================================
# Performance Configuration
# ============================================
# Maximum concurrent API requests
MAX_CONCURRENT_REQUESTS=10
# Connection pool size
CONNECTION_POOL_SIZE=20
# Response compression
ENABLE_COMPRESSION=True

# ============================================
# Data Ingestion Configuration
# ============================================
# Batch size for data ingestion
INGESTION_BATCH_SIZE=100
# Parallel workers for ingestion
INGESTION_WORKERS=4
# Cache availability matrix
AVAILABILITY_CACHE_TTL=3600

# ============================================
# Security Configuration
# ============================================
SESSION_LIFETIME=60
WTF_CSRF_ENABLED=True
REQUIRE_HTTPS=False

# ============================================
# Mail Configuration (for notifications)
# ============================================
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=noreply@worldinsights.bonzainsights.com

# ============================================
# Monitoring & Health Check
# ============================================
HEALTH_CHECK_INTERVAL=60
ENABLE_METRICS=True
