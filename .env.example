# WorldInsights Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================
# Application Settings
# ============================================
FLASK_ENV=development
FLASK_DEBUG=True
# CRITICAL: Generate new secret key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-change-this-in-production

# ============================================
# Database Configuration
# ============================================
DUCKDB_PATH=./data/worldinsights.duckdb
DATABASE_URL=duckdb:///./data/worldinsights.duckdb

# ============================================
# Mail Configuration (for email verification)
# ============================================
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_SSL=False
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_DEFAULT_SENDER=noreply@example.com
MAIL_PASSWORD=your-email-password

# ============================================
# API Configuration
# ============================================
# Rate limiting (requests per minute)
API_RATE_LIMIT=100
# Timeout in seconds
API_TIMEOUT=30
# Number of retry attempts
API_RETRY_COUNT=3

# ============================================
# Cache Configuration
# ============================================
CACHE_TYPE=simple
# Cache TTL in seconds (3600 = 1 hour)
CACHE_TTL=3600

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE=./logs/worldinsights.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=6

# ============================================
# Security Configuration
# ============================================
# Session lifetime in minutes
SESSION_LIFETIME=60
# Enable CSRF protection
WTF_CSRF_ENABLED=True

# Rate Limiting
RATE_LIMIT_ENABLED=True
# Use memory:// for development, redis://localhost:6379 for production
RATE_LIMIT_STORAGE_URL=memory://

# Account Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15

# Password Policy
PASSWORD_MIN_LENGTH=8

# HTTPS Enforcement (set to True in production)
REQUIRE_HTTPS=False

# ============================================
# Data Lake Configuration
# ============================================
DATA_STORAGE_TYPE=local
DATA_LAKE_PATH=data_lake
# DATA_LAKE_PATH=s3://my-wi-datalake (for S3)
DUCKDB_MEMORY_LIMIT=1GB
DATA_WEATHER_UPDATE_INTERVAL=6
DATA_STOCKS_UPDATE_INTERVAL=6
DATA_NEWS_UPDATE_INTERVAL=6
DATA_WORLDBANK_UPDATE_INTERVAL=720
DATA_WHO_UPDATE_INTERVAL=720
DATA_FAO_UPDATE_INTERVAL=720
DATA_NASA_UPDATE_INTERVAL=720
