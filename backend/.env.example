# --- Security & Flask Core ---
# Secret key for session management and token generation.
# In production, use a strong, random string (e.g., `python -c "import secrets; print(secrets.token_hex(32))"`).
SECRET_KEY=dev-secret-key-change-in-production

# Flask Environment: 'development' or 'production'
FLASK_ENV=development

# Enable Flask debug mode (True/False)
FLASK_DEBUG=True

# --- Database Configuration ---
# DuckDB file path relative to the backend (or absolute)
DUCKDB_PATH=../data/worldinsights.duckdb

# SQLAlchemy URI for the User database (SQLite/PostgreSQL)
SQLALCHEMY_DATABASE_URI=sqlite:///../data/worldinsights.db

# --- Mail Server Settings (Email Verification) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False

# Email Credentials
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@worldinsights.bonzainsights.com

# --- Security & Limits ---
# API Rate Limit (requests per day/hour)
API_RATE_LIMIT=100

# CORS Allowed Origins
CORS_ORIGINS=*

# Max failed login attempts before lockout
MAX_LOGIN_ATTEMPTS=5
# Lockout duration in minutes
LOCKOUT_DURATION=15

# --- Data Lake Configuration ---
# Storage type: 'local' or 's3'
DATA_STORAGE_TYPE=local

# DuckDB Memory Limit
DUCKDB_MEMORY_LIMIT=1GB

# Data Update Intervals (in Hours)
DATA_WEATHER_UPDATE_INTERVAL=6
DATA_STOCKS_UPDATE_INTERVAL=6
DATA_NEWS_UPDATE_INTERVAL=6
DATA_WORLDBANK_UPDATE_INTERVAL=720
DATA_WHO_UPDATE_INTERVAL=720
DATA_FAO_UPDATE_INTERVAL=720
DATA_NASA_UPDATE_INTERVAL=720

# AWS S3 Credentials (only if DATA_STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
